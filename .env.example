# --- LLM Backend Priority: Groq > OpenAI > local Ollama ---

# Groq (RECOMMENDED for students): free tier, no credit card needed, and much faster
# than local CPU inference since it runs on Groq's LPU hardware.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (Optional, PAID - pay-as-you-go, requires prepaid billing. No free tier by default.)
OPENAI_API_KEY=

# Local Ollama Configuration (always free, but limited by your own CPU/GPU speed).
# Used only if neither GROQ_API_KEY nor OPENAI_API_KEY is set above.
# If you don't have a GPU, prefer a small model here, e.g. llama3.2:3b or phi3:mini,
# instead of the full llama3.1.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Verifier Agent mode: "llm" (default, more thorough - detects real cross-source
# conflicts) or "deterministic" (rule-based, zero LLM calls, faster/free).
VERIFIER_MODE=llm

# Tavily Web Search API Key (Get a free key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# HuggingFace Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage Directories
DATA_DIR=database
UPLOADS_DIR=uploads
VECTOR_STORE_DIR=vector_store
LOG_DIR=logs
